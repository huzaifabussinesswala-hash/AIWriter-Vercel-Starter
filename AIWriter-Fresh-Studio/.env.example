# Local development only. Never commit a real .env file.
APP_ENV=development
SECRET_KEY=replace-this-with-a-long-random-secret-at-least-32-characters
DATABASE_URL=
COOKIE_SECURE=false
FLASK_DEBUG=false

# Email delivery (recommended on Vercel: Resend HTTPS API)
# Create a Resend API key and verify the sender domain before production sending.
RESEND_API_KEY=
MAIL_DEFAULT_SENDER=AIWriter <verification@your-verified-domain.com>

# SMTP fallback (used only when RESEND_API_KEY is not set)
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=

# AI provider. Vercel cannot reach your own computer's localhost.
AI_API_URL=
AI_API_KEY=
AI_MODEL=qwen3:1.7b
AI_TIMEOUT=30
