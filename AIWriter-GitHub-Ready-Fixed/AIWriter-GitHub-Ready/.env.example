# Local development only. Never commit a real .env file.
APP_ENV=development
SECRET_KEY=replace-this-with-a-long-random-secret-at-least-32-characters
DATABASE_URL=
COOKIE_SECURE=false
FLASK_DEBUG=false

# SMTP settings (required in production; optional in local development)
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# Local Ollama example. Vercel cannot reach your own computer's localhost.
AI_API_URL=http://127.0.0.1:11434/v1
AI_API_KEY=
AI_MODEL=qwen3:1.7b
AI_TIMEOUT=30
