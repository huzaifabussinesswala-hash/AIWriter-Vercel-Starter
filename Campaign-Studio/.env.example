# Configure these in Vercel Project Settings -> Environment Variables.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM=Campaign Studio <verify@your-verified-domain.com>
# Generate independent random secrets (at least 32 characters each).
OTP_SECRET=replace-with-a-long-random-secret-at-least-32-characters
SESSION_SECRET=replace-with-another-long-random-secret-at-least-32-characters
