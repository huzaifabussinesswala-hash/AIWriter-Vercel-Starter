# Add these in Vercel Project Settings -> Environment Variables.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM=Campaign Studio <verify@your-verified-domain.com>
# Generate a random value of at least 32 characters; never reuse a public value.
OTP_SECRET=replace-with-a-long-random-secret-at-least-32-characters
CRON_SECRET=replace-with-a-separate-random-cron-secret
