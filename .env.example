# Copy this file to .env and replace placeholders locally.
# Never commit .env or real credentials.
APP_ENV=development
FLASK_DEBUG=true
SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS
COOKIE_SECURE=false

# Local development database. For Neon, paste the connection string from Neon Console.
# Example shape only; do not use these placeholder values.
DATABASE_URL=sqlite:///instance/aiwriter_dev.db
# DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-HOST/DBNAME?sslmode=require

# Ollama OpenAI-compatible Chat Completions endpoint.
# Ollama must be running on this same computer for local development.
AI_API_URL=http://127.0.0.1:11434/v1
AI_API_KEY=
AI_MODEL=qwen3:1.7b
AI_TIMEOUT=120

# Optional SMTP settings (required only if email verification is enabled).
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
